{
  "name": "fisheye-sms",
  "version": "1.0.0",
  "description": "Editable Remotion recreation: fisheye SMS, moire scanlines and vignette",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts FisheyeSMS out/fisheye-sms.mp4",
    "still": "remotion still src/index.ts FisheyeSMS out/preview.png --frame=40",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": false
  }
}
